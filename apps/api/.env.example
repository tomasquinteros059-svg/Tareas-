DATABASE_URL="postgresql://tareas:tareas@localhost:5432/tareas?schema=public"
PORT=3000
# Firma de tokens de sesión. Generar con: openssl rand -hex 32
JWT_SECRET="cambiar-en-produccion-32-bytes-minimo"
