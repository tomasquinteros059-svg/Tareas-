{
  "name": "tareas-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Marketplace de tareas remuneradas: public\u00e1 una tarea, el primer trabajador calificado que la ve la toma.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @tareas/api dev",
    "build:web": "node apps/web/construir.mjs",
    "generar": "pnpm --filter @tareas/domain build && node apps/web/generar.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @tareas/api migrate",
    "db:seed": "pnpm --filter @tareas/api seed"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
