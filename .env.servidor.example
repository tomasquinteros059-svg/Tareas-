# Configuración del servidor. Copiar a .env y completar:  cp .env.servidor.example .env
# Este archivo NO va al repositorio: tiene las claves de verdad.

# Dominio con el que se saca el certificado HTTPS. Tiene que apuntar (DNS tipo A)
# a la IP de este servidor antes de levantar nada, o Let's Encrypt no lo valida.
DOMINIO=tareas.cl

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=tareas
POSTGRES_PASSWORD=
POSTGRES_DB=tareas
# El host es "db": el nombre del servicio dentro de la red de Docker.
DATABASE_URL=postgresql://tareas:CAMBIAR@db:5432/tareas?schema=public

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Secretos. Generar cada uno con: openssl rand -hex 32 --------------------
JWT_SECRET=
KYC_ENCRYPTION_KEY=

# Dominios desde los que la app puede llamar a la API. En producción es
# obligatorio: sin esto el servidor no arranca.
CORS_ORIGINS=https://tareas.cl,https://www.tareas.cl

# --- Pagos (ver docs/PAGOS.md) ----------------------------------------------
PAYMENTS_PROVIDER=transbank
PAYMENTS_CURRENCY=CLP
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_PRODUCTION=true
TRANSBANK_RETURN_URL=https://tareas.cl/pagos/volver

# --- SMS --------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEFAULT_COUNTRY=CL

# --- Ingreso social ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://tareas.cl/auth
